<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Camera preview for face capture -->
        <androidx.camera.view.PreviewView
            android:id="@+id/enrollPreviewView"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp" />

        <!-- Name field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/label_name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Relationship field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/label_relationship">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRelationship"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:hint="e.g. daughter, doctor, neighbor" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Capture sample button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCaptureSample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_capture_samples_default" />

        <!-- Confirm enrollment button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmEnroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_confirm_enroll" />

    </LinearLayout>
</ScrollView>
